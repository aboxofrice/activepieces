{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist",
    "declaration": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {}
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "node_modules",
    "dist",
    "dist-publish"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
