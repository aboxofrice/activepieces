{
  "displayName": "Narmi Account Opening to Kinective",
  "trigger": {
    "name": "trigger",
    "type": "PIECE_TRIGGER",
    "valid": true,
    "displayName": "Narmi Account Created Webhook",
    "settings": {
      "pieceName": "@activepieces/piece-webhook",
      "pieceVersion": "~0.5.0",
      "triggerName": "catch_webhook",
      "input": {},
      "inputUiInfo": {}
    },
    "nextAction": {
      "name": "step_1",
      "type": "CODE",
      "valid": true,
      "displayName": "Extract Account Data from Webhook",
      "settings": {
        "input": {
          "payload": "{{trigger['body']}}"
        },
        "sourceCode": "export const code = async (inputs) => {\n  const payload = inputs.payload;\n  return {\n    eventType: payload.type,\n    accountId: payload.data?.object?.id,\n    userId: payload.data?.object?.user_id,\n    accountType: payload.data?.object?.account_type,\n    accountSubtype: payload.data?.object?.account_subtype,\n    status: payload.data?.object?.status,\n    currency: payload.data?.object?.currency,\n    createdAt: payload.data?.object?.created_at\n  };\n}"
      },
      "nextAction": {
        "name": "step_2",
        "type": "PIECE",
        "valid": true,
        "displayName": "Get Narmi Account Application",
        "settings": {
          "pieceName": "@company/narmi",
          "pieceVersion": "~0.0.0",
          "actionName": "get_account_application",
          "input": {
            "auth": "{{connections['narmi']}}",
            "uuid": "{{step_1['userId']}}"
          },
          "inputUiInfo": {}
        },
        "nextAction": {
          "name": "step_3",
          "type": "CODE",
          "valid": true,
          "displayName": "Extract Applicant Info",
          "settings": {
            "input": {
              "application": "{{step_2['application']}}"
            },
            "sourceCode": "export const code = async (inputs) => {\n  const app = inputs.application;\n  const applicant = app?.applicants?.find(a => a.is_primary) || app?.applicants?.[0];\n  const user = applicant?.user;\n  const address = applicant?.address || {};\n  \n  return {\n    firstName: applicant?.first_name || '',\n    middleName: applicant?.middle_name || '',\n    lastName: applicant?.last_name || '',\n    email: applicant?.email || user?.email || '',\n    phone: applicant?.phone || '',\n    taxId: user?.institution_user_identifier || '',\n    streetAddress: address.street_address || '',\n    streetAddress2: address.street_address_2 || '',\n    city: address.city || '',\n    stateCode: address.region_code || '',\n    postalCode: address.postal_code || '',\n    countryCode: address.country_code || 'US',\n    applicationId: app?.id || '',\n    coreUserId: app?.core_user_id || ''\n  };\n}"
          },
          "nextAction": {
            "name": "step_4",
            "type": "PIECE",
            "valid": true,
            "displayName": "Search Party in Kinective by Tax ID",
            "settings": {
              "pieceName": "@company/kinective-placeholder",
              "pieceVersion": "~0.0.0",
              "actionName": "get_party_list",
              "input": {
                "auth": "{{connections['kinective-placeholder']}}",
                "taxId": "{{step_3['taxId']}}",
                "maxRecords": 1
              },
              "inputUiInfo": {}
            },
            "nextAction": {
              "name": "step_5",
              "type": "CODE",
              "valid": true,
              "displayName": "Check if Party Exists",
              "settings": {
                "input": {
                  "partyListResponse": "{{step_4}}"
                },
                "sourceCode": "export const code = async (inputs) => {\n  const response = inputs.partyListResponse;\n  const parties = response?.PartyListRec || [];\n  const partyExists = parties.length > 0;\n  const existingPartyId = partyExists ? parties[0]?.PartyKeys?.PartyId : null;\n  \n  return {\n    partyExists,\n    existingPartyId\n  };\n}"
              },
              "nextAction": {
                "name": "step_6",
                "type": "BRANCH",
                "valid": true,
                "displayName": "Party Exists?",
                "settings": {
                  "conditions": [[{
                    "operator": "BOOLEAN_IS_TRUE",
                    "firstValue": "{{step_5['partyExists']}}",
                    "secondValue": "",
                    "caseSensitive": false
                  }]]
                },
                "onSuccessAction": {
                  "name": "step_7",
                  "type": "PIECE",
                  "valid": true,
                  "displayName": "Update Existing Party with Address",
                  "settings": {
                    "pieceName": "@company/kinective-placeholder",
                    "pieceVersion": "~0.0.0",
                    "actionName": "update_party",
                    "input": {
                      "auth": "{{connections['kinective-placeholder']}}",
                      "partyId": "{{step_5['existingPartyId']}}",
                      "partyData": {
                        "PersonPartyInfo": {
                          "PersonName": {
                            "FirstName": "{{step_3['firstName']}}",
                            "MiddleName": "{{step_3['middleName']}}",
                            "LastName": "{{step_3['lastName']}}"
                          },
                          "Contact": {
                            "PostAddr": {
                              "Addr1": "{{step_3['streetAddress']}}",
                              "Addr2": "{{step_3['streetAddress2']}}",
                              "City": "{{step_3['city']}}",
                              "StateProv": "{{step_3['stateCode']}}",
                              "PostalCode": "{{step_3['postalCode']}}",
                              "Country": "{{step_3['countryCode']}}"
                            },
                            "PhoneNum": "{{step_3['phone']}}",
                            "Email": "{{step_3['email']}}"
                          }
                        }
                      },
                      "overrideAutoAck": true
                    },
                    "inputUiInfo": {}
                  },
                  "nextAction": {
                    "name": "step_9",
                    "type": "PIECE",
                    "valid": true,
                    "displayName": "Create Deposit Account (Existing Party)",
                    "settings": {
                      "pieceName": "@company/kinective-placeholder",
                      "pieceVersion": "~0.0.0",
                      "actionName": "account_create",
                      "input": {
                        "auth": "{{connections['kinective-placeholder']}}",
                        "accountType": "DDA",
                        "partyId": "{{step_5['existingPartyId']}}",
                        "openingBalance": 0
                      },
                      "inputUiInfo": {}
                    },
                    "nextAction": null
                  }
                },
                "onFailureAction": {
                  "name": "step_8",
                  "type": "PIECE",
                  "valid": true,
                  "displayName": "Create New Party",
                  "settings": {
                    "pieceName": "@company/kinective-placeholder",
                    "pieceVersion": "~0.0.0",
                    "actionName": "add_party",
                    "input": {
                      "auth": "{{connections['kinective-placeholder']}}",
                      "partyData": {
                        "PersonPartyInfo": {
                          "PersonName": {
                            "FirstName": "{{step_3['firstName']}}",
                            "MiddleName": "{{step_3['middleName']}}",
                            "LastName": "{{step_3['lastName']}}"
                          },
                          "TaxIdent": "{{step_3['taxId']}}",
                          "Contact": {
                            "PostAddr": {
                              "Addr1": "{{step_3['streetAddress']}}",
                              "Addr2": "{{step_3['streetAddress2']}}",
                              "City": "{{step_3['city']}}",
                              "StateProv": "{{step_3['stateCode']}}",
                              "PostalCode": "{{step_3['postalCode']}}",
                              "Country": "{{step_3['countryCode']}}"
                            },
                            "PhoneNum": "{{step_3['phone']}}",
                            "Email": "{{step_3['email']}}"
                          }
                        }
                      }
                    },
                    "inputUiInfo": {}
                  },
                  "nextAction": {
                    "name": "step_10",
                    "type": "CODE",
                    "valid": true,
                    "displayName": "Extract New Party ID",
                    "settings": {
                      "input": {
                        "addPartyResponse": "{{step_8}}"
                      },
                      "sourceCode": "export const code = async (inputs) => {\n  const response = inputs.addPartyResponse;\n  const partyId = response?.PartyStatusRec?.PartyKeys?.PartyId || response?.PartyRec?.PartyKeys?.PartyId;\n  return { newPartyId: partyId };\n}"
                    },
                    "nextAction": {
                      "name": "step_11",
                      "type": "PIECE",
                      "valid": true,
                      "displayName": "Create Deposit Account (New Party)",
                      "settings": {
                        "pieceName": "@company/kinective-placeholder",
                        "pieceVersion": "~0.0.0",
                        "actionName": "account_create",
                        "input": {
                          "auth": "{{connections['kinective-placeholder']}}",
                          "accountType": "DDA",
                          "partyId": "{{step_10['newPartyId']}}",
                          "openingBalance": 0
                        },
                        "inputUiInfo": {}
                      },
                      "nextAction": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "schemaVersion": "10"
}
